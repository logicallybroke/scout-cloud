# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Environment and secrets (commit only .env.example with variable names, no values)
.env
.env.*
!.env.example
*.pem

# Local databases and dumps
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal
*.dump
/data/

# Tests and coverage
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*

# Hosted-runner local artifacts (root only, so source folders with these names are not ignored)
/.browser-profiles/
/runner-artifacts/
/screenshots/
*.har
# Playwright storage state holds demo-account cookies (secrets)
playwright/.auth/
*storageState*.json

# Deployment and tooling
.vercel/
.turbo/
.cache/

# OS and editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
