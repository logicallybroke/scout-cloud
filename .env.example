# Names only. Real values go in .env.local (development) or the host's variables (production).
OPENAI_API_KEY=
# Server key mixed into passcode hashes. Required in production.
SCOUT_TOKEN_PEPPER=
# D1's one hard monthly cap on model spend, in US dollars (Ayush, 14 Oct: 4).
SCOUT_GLOBAL_MONTHLY_BUDGET_USD=4
# Where the JSON store lives; on Railway, the mounted volume (for example /data).
SCOUT_DATA_DIR=
# One long random value; enables POST /v1/operator/projects (leave empty to switch it off).
SCOUT_OPERATOR_SECRET=
